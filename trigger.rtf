DELIMITER $$

DROP TRIGGER IF EXISTS after_users_soft_delete$$

CREATE TRIGGER after_users_soft_delete
AFTER UPDATE ON users
FOR EACH ROW
BEGIN

    IF OLD.deleted_at IS NULL AND NEW.deleted_at IS NOT NULL THEN

        -- Soft delete placement applications
        UPDATE placement_applications
        SET deleted_at = NEW.deleted_at
        WHERE hospital_id = NEW.id;

        -- Soft delete enrolment hirings
        UPDATE enrolment_hirings
        SET deleted_at = NEW.deleted_at
        WHERE hospital_id = NEW.id;

        -- Remove hospital from enrolments only
        UPDATE enrolments
        SET hospital_id = NULL
        WHERE hospital_id = NEW.id;

        UPDATE enrolments
        SET deleted_at = NEW.deleted_at
        WHERE vendor_id = NEW.id;

    END IF;

END$$

DELIMITER ;
